APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Secure Gmail API delivery. Keep credentials in the server environment only,
# then set MAIL_MAILER=gmail-api and MAIL_FROM_ADDRESS to GMAIL_API_SENDER.
GMAIL_API_CLIENT_ID=
GMAIL_API_CLIENT_SECRET=
GMAIL_API_REFRESH_TOKEN=
GMAIL_API_SENDER=info@iuoamc.uk
GMAIL_API_TIMEOUT=20

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# IUOAMC AI Concierge — keep the API key on the server only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT=30

# Crossref DOI metadata deposits. Leave empty until the verified member credentials and DOI prefix are issued.
CROSSREF_USERNAME=
CROSSREF_PASSWORD=
CROSSREF_DEPOSITOR_NAME=
CROSSREF_DEPOSITOR_EMAIL=info@iuoamc.uk
CROSSREF_ENDPOINT=https://doi.crossref.org/servlet/deposit
CROSSREF_TEST_ENDPOINT=https://test.crossref.org/servlet/deposit

# Official PAdES signing. Keep the PKCS#12 archive and passphrase file outside the repository.
IUOAMC_PADES_ENABLED=false
IUOAMC_PADES_BINARY=/opt/iuoamc-pades/bin/pyhanko
IUOAMC_PADES_PKCS12_PATH=/etc/iuoamc-secrets/certificate-signing.p12
IUOAMC_PADES_PASSPHRASE_FILE=/etc/iuoamc-secrets/certificate-signing.pass
IUOAMC_PADES_TRUST_ROOT_PATH=
IUOAMC_PADES_TIMESTAMP_URL=
IUOAMC_PADES_PROFILE=PAdES-B-B
IUOAMC_PADES_SIGNATURE_FIELD=1/392,76,580,130/IUOAMC_Authorized_Signature
# Keep false to preserve the cryptographic signature without overlaying a visible signature box on the certificate artwork.
IUOAMC_PADES_VISIBLE_SIGNATURE=false
IUOAMC_PADES_TIMEOUT=90
